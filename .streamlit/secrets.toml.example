# Copy this file to .streamlit/secrets.toml for local development.
# Never commit the real secrets.toml. On Streamlit Community Cloud, paste the
# same [auth] block into the app's Secrets settings instead.
#
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Web application). Authorised redirect URI must match redirect_uri exactly.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"
client_id = "your-google-client-id.apps.googleusercontent.com"
client_secret = "your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
