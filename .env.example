# Local SQLite database. The database file is created automatically.
DATABASE_URL=sqlite:///./data/expenses-single-user.db
CURRENCY=INR
TIMEZONE=Asia/Kolkata

# Groq API configuration. Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Primary model. Switch to openai/gpt-oss-20b here if needed; no code changes.
GROQ_MODEL=openai/gpt-oss-120b

# Optional comma-separated fallback models, used only for transient Groq errors.
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
